# ========================================
# Backend API Configuration
# ========================================
PORT=5000
NODE_ENV=development

# ========================================
# MongoDB Database Configuration
# ========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_DB=tripzaapp

# ========================================
# Razorpay Payment Gateway
# ========================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ========================================
# Clerk Authentication (Backend Validation)
# ========================================
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# ========================================
# CORS Configuration
# ========================================
# Frontend URL for CORS (React Native Expo)
FRONTEND_URL=http://192.168.0.108:8081
ALLOWED_ORIGINS=http://localhost:8081,http://192.168.0.108:8081,http://10.0.2.2:8081

# ========================================
# API Configuration
# ========================================
API_VERSION=v1
API_PREFIX=/api
