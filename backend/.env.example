# ========================================
# Backend API Configuration
# ========================================
PORT=5000
NODE_ENV=development

# ========================================
# MongoDB Database Configuration
# ========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_DB=tripzaapp
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# ========================================
# Razorpay Payment Gateway
# ========================================
# Required for payment order creation and signature verification.
# No code fallback is allowed for these credentials.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ========================================
# Clerk Authentication (Backend Validation)
# ========================================
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# ========================================
# CORS Configuration
# ========================================
# Frontend URL for CORS (React Native Expo)
FRONTEND_URL=http://10.84.104.123:8081
ALLOWED_ORIGINS=http://localhost:8081,http://10.84.104.123:8081,http://10.0.2.2:8081

# ========================================
# API Configuration
# ========================================
API_VERSION=v1
API_PREFIX=/api

# ========================================
# Maps / Geo
# ========================================
# Optional for local autocomplete/geocode fallback, required for Google place details and directions.
GOOGLE_MAPS_API_KEY=

# ========================================
# Security / Runtime
# ========================================
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=false
ENABLE_BACKGROUND_TASKS=true
SERVER_SHUTDOWN_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Development-only approval pending window. Production always uses 5 minutes.
APPROVAL_PENDING_WINDOW_MINUTES=30

# ========================================
# Event Bus / Cache
# ========================================
# Comma-separated Kafka brokers. Leave empty to run without Kafka locally.
KAFKA_BROKERS=
KAFKA_CLIENT_ID=tripza-api
# When true, Kafka publish failures fail the request. Keep false until event consumers are required.
EVENT_BUS_STRICT=false

# Redis will be used for socket scaling, seat locks, location cache, and rate-limit stores.
REDIS_URL=

# Optional Python/FastAPI matching sidecar. Leave empty to use in-process fare logic.
MATCHING_SERVICE_URL=http://localhost:7001
MATCHING_SERVICE_REQUIRED=false
MATCHING_SERVICE_TIMEOUT_MS=1500

# ========================================
# Cloudinary Uploads
# ========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
