{
  "name": "raaheasy",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "build:web": "expo export --platform web && node scripts/prepare-amplify-static-routes.js",
    "lint": "expo lint",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "backend:arch": "node scripts/backend-architecture-guard.js",
    "matching:check": "python -m compileall -q backend/services/matching-service/app",
    "backend:check": "npm --prefix backend run check && npm run matching:check && npm run typecheck",
    "deploy:check": "node scripts/check-deployment-readiness.js",
    "deploy:check:prod": "node -e \"process.env.REQUIRE_PROD_ENV='true'; require('./scripts/check-deployment-readiness.js')\"",
    "services:kafka:health": "cd backend && npm run kafka:health",
    "services:kafka:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local-kafka.ps1",
    "services:topics": "cd backend && npm run kafka:topics",
    "services:up": "docker compose up --build -d",
    "services:local:up": "powershell -ExecutionPolicy Bypass -File scripts/start-local-services.ps1",
    "services:app:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local-app-services.ps1",
    "services:local:down": "powershell -ExecutionPolicy Bypass -File scripts/stop-local-services.ps1",
    "services:verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-services.ps1",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f api worker matching-service",
    "services:status": "docker compose ps",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^0.19.0",
    "@clerk/clerk-react": "^4.30.3",
    "@expo/vector-icons": "^15.0.2",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "axios": "^1.7.7",
    "expo": "^54.0.10",
    "expo-auth-session": "~7.0.10",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-location": "^19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.8",
    "expo-secure-store": "^15.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "^1.26.20",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "socket.io-client": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "directories": {
    "lib": "lib"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": ""
}
