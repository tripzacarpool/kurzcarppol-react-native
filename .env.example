# RaahEasy Environment Variables
# Copy this file to .env and fill in your values

# ========================================
# Google Maps Configuration
# ========================================
# Get your API key from: https://console.cloud.google.com/
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAWpVF1UfbtUsUbdv7SM8jautI7Y0QWx0U

# ========================================
# Backend API Configuration
# ========================================
# Your backend server URL (no trailing slash) - REQUIRED!
# Set this to your backend URL - no fallback will be used
EXPO_PUBLIC_API_URL=http://10.84.104.123:5000
# Optional. Defaults to EXPO_PUBLIC_API_URL. Use only when realtime is hosted separately.
EXPO_PUBLIC_SOCKET_URL=http://10.84.104.123:5000

# Local Development URLs (replace the above):
# EXPO_PUBLIC_API_URL=http://localhost:5000
# For Android Emulator: EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
# For Physical Device: EXPO_PUBLIC_API_URL=http://10.84.104.123:5000

# ========================================
# Clerk Authentication
# ========================================
# Get these from: https://dashboard.clerk.com/
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# ========================================
# Razorpay Payment Gateway
# ========================================
# Get these from: https://dashboard.razorpay.com/
EXPO_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
